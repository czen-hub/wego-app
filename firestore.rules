rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()    { return request.auth != null; }
    function isSelf(uid) { return request.auth.uid == uid; }
    function isAdmin()   {
      return isAuth() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Admins (only readable by the admin themselves; written via Firebase console) ──
    match /admins/{uid} {
      allow read:  if isAuth() && isSelf(uid);
      allow write: if false;
    }

    // ── Drivers ───────────────────────────────────────────────────────────────
    // Any authenticated user can read driver docs (passenger app shows driver info).
    // Only the driver themselves or an admin can write.
    match /drivers/{driverId} {
      allow read:  if isAuth();
      allow write: if isAuth() && (isSelf(driverId) || isAdmin());
    }

    // ── Passengers ────────────────────────────────────────────────────────────
    // Drivers need to read passenger name/rating on accepted rides.
    // Only the passenger themselves or an admin can write.
    match /passengers/{passengerId} {
      allow read:  if isAuth();
      allow write: if isAuth() && (isSelf(passengerId) || isAdmin());
    }

    // ── Rides ─────────────────────────────────────────────────────────────────
    match /rides/{rideId} {

      // Read: admin sees all; otherwise own ride (as passenger or driver) OR unclaimed queued ride.
      allow read: if isAdmin() || (isAuth() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId   == request.auth.uid ||
        resource.data.status in ['pending', 'reserved']
      ));

      // Create: passengers only, must set themselves as owner, status must be pending.
      allow create: if isAuth()
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.status      == 'pending'
        && request.resource.data.driverId    == null;

      allow update: if isAdmin() || (isAuth() && (

        // Passenger cancels pending, accepted, or reserved ride (no active driver yet).
        (resource.data.passengerId == request.auth.uid
          && resource.data.status in ['pending', 'accepted', 'reserved']
          && request.resource.data.status == 'cancelled')

        ||

        // Passenger cancels in-progress ride only after filing a dispute (ghost ride).
        (resource.data.passengerId == request.auth.uid
          && resource.data.status == 'inProgress'
          && resource.data.disputed == true
          && request.resource.data.status == 'cancelled')

        ||

        // Passenger files a dispute on an in-progress ride (ghost ride / not picked up).
        (resource.data.passengerId == request.auth.uid
          && resource.data.status == 'inProgress'
          && request.resource.data.disputed == true)

        ||

        // Passenger requests or edits a stop during an in-progress ride.
        // Status must stay inProgress and only stop-related fields may change.
        (resource.data.passengerId == request.auth.uid
          && resource.data.status == 'inProgress'
          && request.resource.data.status == 'inProgress'
          && request.resource.data.disputed != true
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stopCount', 'stopFeeTotal', 'pendingStop', 'stops']))

        ||

        // Driver claims an unclaimed pending ride (transaction in code prevents races).
        (resource.data.status == 'pending'
          && resource.data.driverId == null
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status   == 'accepted')

        ||

        // Driver claims a reserved (pre-booked) ride.
        (resource.data.status == 'reserved'
          && resource.data.driverId == null
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status   == 'accepted')

        ||

        // Driver updates their own active ride (location, arrived, inProgress, completed).
        (resource.data.driverId == request.auth.uid
          && resource.data.status in ['accepted', 'arrived', 'inProgress'])

        ||

        // Driver acknowledges a dispute alert.
        (resource.data.driverId == request.auth.uid
          && resource.data.disputed == true
          && request.resource.data.driverAlertSeenAt != null)

        ||

        // Either party submits a rating after the ride is completed.
        (resource.data.status == 'completed'
          && (resource.data.passengerId == request.auth.uid
              || resource.data.driverId == request.auth.uid))
      ));

      // No hard deletes — cancelled status is the soft-delete.
      allow delete: if false;
    }

    // ── Earnings ──────────────────────────────────────────────────────────────
    // Drivers write and read their own earnings. Admin reads all.
    match /earnings/{entryId} {
      allow create: if isAuth() && request.resource.data.driverId == request.auth.uid;
      allow read:   if isAdmin() || (isAuth() && resource.data.driverId == request.auth.uid);
      allow update, delete: if false;
    }

    // ── Messages ──────────────────────────────────────────────────────────────
    // Drivers read their own inbox; updates allowed for marking read. Admin reads all.
    match /messages/{msgId} {
      allow read:   if isAdmin() || (isAuth() && resource.data.driverId == request.auth.uid);
      allow update: if isAuth() && resource.data.driverId == request.auth.uid;
      allow create: if isAuth();
      allow delete: if false;
    }

    // ── Opportunities ─────────────────────────────────────────────────────────
    match /opportunities/{oppId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Governance Votes ──────────────────────────────────────────────────────
    // Drivers cast and update their own votes; all members can read vote totals.
    match /governance_votes/{voteId} {
      allow create, update: if isAuth() && request.resource.data.driverId == request.auth.uid;
      allow read: if isAuth();
      allow delete: if false;
    }

    // ── Disputes ──────────────────────────────────────────────────────────────
    // Passengers file disputes. Read restricted to the passenger who filed or admin.
    match /disputes/{disputeId} {
      allow create: if isAuth() && request.resource.data.passengerId == request.auth.uid;
      allow read:   if isAdmin() || (isAuth() && resource.data.passengerId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Withdrawal Requests ───────────────────────────────────────────────────
    // Drivers submit payout requests for their own earnings only. Admin reads + updates all.
    match /withdrawalRequests/{reqId} {
      allow create: if isAuth()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow read:   if isAdmin() || (isAuth() && resource.data.driverId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Road Reports ──────────────────────────────────────────────────────────
    // Drivers and passengers can report road issues; admin reads and manages.
    match /roadReports/{reportId} {
      allow create: if isAuth()
        && (request.resource.data.driverId == request.auth.uid
            || request.resource.data.userId == request.auth.uid);
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // ── Ride Chat ─────────────────────────────────────────────────────────────
    // Only ride participants (passenger or driver) may create or read messages.
    match /ride_chats/{msgId} {
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && (get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.passengerId == request.auth.uid
            || get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.driverId  == request.auth.uid);
      allow read: if isAdmin() || (isAuth()
        && (get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.passengerId == request.auth.uid
            || get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.driverId  == request.auth.uid));
      allow update, delete: if false;
    }
  }
}
