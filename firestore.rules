rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()      { return request.auth != null; }
    function isSelf(uid)   { return request.auth.uid == uid; }

    // ── Drivers ───────────────────────────────────────────────────────────────
    // Any authenticated user can read driver docs (passenger app shows driver info).
    // Only the driver themselves can write their own document.
    match /drivers/{driverId} {
      allow read:  if isAuth();
      allow write: if isAuth() && isSelf(driverId);
    }

    // ── Passengers ────────────────────────────────────────────────────────────
    // Drivers need to read passenger name/rating on accepted rides.
    // Only the passenger themselves can write their own document.
    match /passengers/{passengerId} {
      allow read:  if isAuth();
      allow write: if isAuth() && isSelf(passengerId);
    }

    // ── Rides ─────────────────────────────────────────────────────────────────
    match /rides/{rideId} {

      // Read: own ride (as passenger or driver) OR any pending ride (drivers need
      // to see the queue; pending rides have no sensitive data beyond address/fare).
      allow read: if isAuth() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId   == request.auth.uid ||
        resource.data.status == 'pending'
      );

      // Create: passengers only, must set themselves as owner, status must be pending.
      allow create: if isAuth()
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.status      == 'pending'
        && request.resource.data.driverId    == null;

      allow update: if isAuth() && (

        // Passenger cancels their own pending, accepted, reserved, or in-progress ride.
        (resource.data.passengerId == request.auth.uid
          && resource.data.status in ['pending', 'accepted', 'reserved', 'inProgress']
          && request.resource.data.status == 'cancelled')

        ||

        // Passenger files a dispute on an in-progress ride (ghost ride / not picked up).
        (resource.data.passengerId == request.auth.uid
          && resource.data.status == 'inProgress'
          && request.resource.data.disputed == true)

        ||

        // Passenger requests or edits a stop during an in-progress ride
        // (updates stopCount, stopFeeTotal, pendingStop, stops).
        // Status must stay inProgress — passenger cannot change it via this rule.
        (resource.data.passengerId == request.auth.uid
          && resource.data.status == 'inProgress'
          && request.resource.data.status == 'inProgress'
          && request.resource.data.disputed != true)

        ||

        // Driver claims an unclaimed pending ride (transaction in code prevents races).
        (resource.data.status == 'pending'
          && resource.data.driverId == null
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status   == 'accepted')

        ||

        // Driver updates their own active ride (location, arrived, inProgress, completed).
        (resource.data.driverId == request.auth.uid
          && resource.data.status in ['accepted', 'arrived', 'inProgress'])

        ||

        // Driver acknowledges a dispute alert.
        (resource.data.driverId == request.auth.uid
          && resource.data.disputed == true
          && request.resource.data.driverAlertSeenAt != null)

        ||

        // Either party submits a rating after the ride is completed.
        (resource.data.status == 'completed'
          && (resource.data.passengerId == request.auth.uid
              || resource.data.driverId == request.auth.uid))
      );

      // No hard deletes — cancelled status is the soft-delete.
      allow delete: if false;
    }

    // ── Earnings ──────────────────────────────────────────────────────────────
    // Drivers write their own earnings on trip complete; any auth user reads
    // (needed for cooperative fleet reserve fund total across all drivers).
    match /earnings/{entryId} {
      allow create: if isAuth() && request.resource.data.driverId == request.auth.uid;
      allow read:   if isAuth();
      allow update, delete: if false;
    }

    // ── Messages ──────────────────────────────────────────────────────────────
    // Drivers read their own inbox; updates allowed for marking read.
    match /messages/{msgId} {
      allow read:   if isAuth() && resource.data.driverId == request.auth.uid;
      allow update: if isAuth() && resource.data.driverId == request.auth.uid;
      allow create: if isAuth();
      allow delete: if false;
    }

    // ── Opportunities ─────────────────────────────────────────────────────────
    match /opportunities/{oppId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── Governance Votes ──────────────────────────────────────────────────────
    // Drivers cast and update their own votes; all members can read vote totals.
    match /governance_votes/{voteId} {
      allow create, update: if isAuth() && request.resource.data.driverId == request.auth.uid;
      allow read: if isAuth();
      allow delete: if false;
    }

    // ── Disputes ──────────────────────────────────────────────────────────────
    // Passengers can file disputes; support staff read them externally.
    match /disputes/{disputeId} {
      allow create: if isAuth();
      allow read:   if isAuth();
      allow update, delete: if false;
    }

    // ── Ride Chat ─────────────────────────────────────────────────────────────
    match /ride_chats/{msgId} {
      allow read, create: if isAuth();
      allow update, delete: if false;
    }
  }
}
