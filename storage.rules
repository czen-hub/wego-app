rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Drivers may read/write only their own files
    match /drivers/{driverId}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == driverId;
      allow write: if request.auth != null
                   && request.auth.uid == driverId
                   && request.resource.size < 10 * 1024 * 1024   // 10 MB max
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Passengers may read/write only their own files
    match /passengers/{passengerId}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == passengerId;
      allow write: if request.auth != null
                   && request.auth.uid == passengerId
                   && request.resource.size < 10 * 1024 * 1024   // 10 MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
